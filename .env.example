# Copiar a .env (no se versiona) y ajustar. docker compose lo lee solo.

# --- PostgreSQL ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432

# --- API (.NET): la sección se separa con doble guion bajo ---
ConnectionStrings__Wallet=Host=localhost;Port=5432;Database=wallet;Username=wallet;Password=wallet;Timeout=5

Issuer__Did=did:example:futbol
Issuer__KeyId=key-1
Issuer__CredentialBaseUri=https://credenciales.futbol.com.ar/
# Secreto HMAC-SHA256: al menos 32 bytes. Este valor es solo de ejemplo; usar uno propio.
Issuer__SigningKey=cambiar-por-un-secreto-de-al-menos-32-bytes

Tenant__Id=club-futbol

# Aplica las migraciones al arrancar (por defecto true).
Database__MigrateOnStartup=true

# Solo en Development: hace que toda alta falle al firmar, para demostrar UC01 5a.
Issuer__SimulateFailure=false
